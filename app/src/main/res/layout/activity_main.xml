<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF170D02">

    <WebView
        android:id="@+id/webview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/shortcut_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/shortcut_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel"
        android:visibility="gone"
        app:layout_constrainedHeight="true"
        app:layout_constraintHeight_max="420dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <TextView
                style="@style/PanelHeading"
                android:text="@string/panel_keys" />

            <com.hermes.webui.FlowLayout
                android:id="@+id/flow_keys"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                style="@style/PanelHeading"
                android:layout_marginTop="14dp"
                android:text="@string/panel_commands" />

            <com.hermes.webui.FlowLayout
                android:id="@+id/flow_commands"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_status"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_status"
            android:padding="9dp"
            android:src="@drawable/ic_antenna"
            android:contentDescription="@string/status_checking" />

        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_keyboard"
            android:contentDescription="@string/menu_open" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_up"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_arrow_up"
            android:contentDescription="@string/key_up" />

        <ImageButton
            android:id="@+id/btn_down"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_arrow_down"
            android:contentDescription="@string/key_down" />

        <LinearLayout
            android:id="@+id/btn_enter"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_enter"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="18dp"
            android:contentDescription="@string/key_enter">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_keyboard_return"
                android:importantForAccessibility="no"
                app:tint="#FF170D02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Enter"
                android:textColor="#FF170D02"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="#FF2C2C31" />

        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_refresh"
            android:contentDescription="@string/refresh" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
