    <string name="settings">서버 설정</string>
    <string name="setup_title">내 Hermes에 연결</string>
    <string name="setup_intro">내 컴퓨터에서 실행 중인 Hermes Agent 대시보드(hermes dashboard)의 주소를 입력하세요.</string>
